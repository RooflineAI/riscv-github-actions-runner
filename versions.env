# Build inputs for the linux-riscv64 runner. patch_runner.sh hashes this file
# into PATCH_FINGERPRINT, so bumping any pin changes the build's identity.

# Upstream actions/runner tag, without the leading "v". Release tags of this
# repo are v<RUNNER_VERSION>-<n>.
RUNNER_VERSION=2.338.2

# Official .NET SDK image the build runs in. It must ship the same runtime
# version as the riscv64 packs below (SDK 10.0.404 ships runtime 10.0.15).
DOTNET_SDK_VERSION=10.0.404

# Source-built .NET from filipnavara/dotnet-riscv, the only source of
# linux-riscv64 runtime packs (nuget.org has none).
DOTNET_RISCV_RELEASE=10.0.115
DOTNET_RISCV_ARTIFACTS=Private.SourceBuilt.Artifacts.10.0.115-servicing.26561.199.linux-riscv64.tar.gz
DOTNET_RISCV_ARTIFACTS_SHA256=0af81ae935f813d0e4b6ca41670cd1700e9c5546dc1c59360fc4460913358713

# Node 24 for riscv64, from unofficial-builds.nodejs.org. Pinned apart from
# upstream's NODE24_VERSION, which tracks the official builds: the 24.22.1
# riscv64 build segfaults in V8's Sparkplug compiler (it runs with
# --no-sparkplug) on a SiFive P550 and a SpacemiT K3 alike, while 24.21.0 runs
# on both. Check a new version on a board before bumping: node -e with a loop
# is enough to trigger it.
NODE24_RISCV_VERSION=24.21.0
